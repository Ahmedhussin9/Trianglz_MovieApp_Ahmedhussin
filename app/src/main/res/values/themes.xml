<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        AppCompat DayNight, so the in-app theme choice (AppCompatDelegate night mode) switches the
        window and system bars too. The Compose UI is themed by MovieAppTheme; this theme only
        covers what is drawn before Compose (window background, from values / values-night colors).
    -->
    <style name="Theme.MovieApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
